{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/grim-dawn-encounter-lab/dataset-manifest.schema.json",
  "title": "Grim Dawn dataset input manifest",
  "type": "object",
  "required": ["schema_version", "tool_version", "generated_at", "channel", "channel_evidence", "install", "content", "files", "warnings"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "tool_version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "channel": { "enum": ["unknown", "stable", "public_test"] },
    "channel_evidence": { "enum": ["not_established", "user_supplied"] },
    "install": {
      "type": "object",
      "required": ["path", "detection", "checked_candidates"],
      "properties": {
        "path": { "type": ["string", "null"] },
        "detection": { "enum": ["explicit", "steam_default", "not_found"] },
        "checked_candidates": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "required": ["base", "gdx1", "gdx2", "gdx3", "localization_en", "localization_ja"],
      "additionalProperties": { "type": "boolean" }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "group", "relative_path", "exists"],
        "properties": {
          "key": { "type": "string" },
          "group": { "type": "string" },
          "relative_path": { "type": "string" },
          "exists": { "type": "boolean" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "modified_at": { "type": "string", "format": "date-time" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": { "code": { "type": "string" }, "message": { "type": "string" } },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
